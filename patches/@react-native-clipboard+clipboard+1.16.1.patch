+package com.reactnativecommunity.clipboard;
+
+import android.app.AlarmManager;
+import android.app.PendingIntent;
+import android.content.BroadcastReceiver;
+import android.content.ClipData;
+import android.content.ClipDescription;
+import android.content.ClipboardManager;
+import android.content.Context;
+import android.content.Intent;
+import android.content.SharedPreferences;
+import android.os.Build;
+import android.os.Handler;
+import android.os.Looper;
+import android.os.PersistableBundle;
+import android.os.SystemClock;
+import java.util.UUID;
+
+/**
+ * Clears sensitive text copied with setStringExpire after EXPIRE_TIME_MS without relying on
+ * React Native JS timers, which are paused while the activity is in the background.
+ * An in-process Handler gives a precise expiry while the process is running; an AlarmManager
+ * broadcast is the backstop when the process is frozen by the cached apps freezer or killed.
+ * Alarms do not survive a reboot or force stop, so pending expiries are also handled on boot,
+ * on app update and when the module is next created.
+ *
+ * The copied text is never kept: the clip is tagged with a random token that is persisted, and
+ * expiry only clears the clipboard while it still carries that token (or cannot be read at all,
+ * as background apps cannot read the clipboard on Android 10+).
+ */
+public class ClipboardExpiryReceiver extends BroadcastReceiver {
+  static final long EXPIRE_TIME_MS = 60000;
+  private static final String EXTRA_IS_SENSITIVE = "android.content.extra.IS_SENSITIVE";
+  private static final String EXTRA_EXPIRY_TOKEN = "com.reactnativecommunity.clipboard.EXPIRY_TOKEN";
+  private static final String PREFS = "RNCClipboardExpiry";
+  private static final String KEY_TOKEN = "token";
+  private static final String KEY_EXPIRES_AT = "expiresAt";
+  private static final Handler handler = new Handler(Looper.getMainLooper());
+  private static Context appContext = null;
+  private static final Runnable inProcessExpiry = new Runnable() {
+    @Override
+    public void run() {
+      if (appContext != null) {
+        expire(appContext);
+      }
+    }
+  };
+
+  static synchronized void setStringExpire(Context context, String content) {
+    Context app = context.getApplicationContext();
+    appContext = app;
+    String token = UUID.randomUUID().toString();
+    // Persisted before the clip is written so an expiry is never lost once the secret is copied.
+    prefs(app)
+        .edit()
+        .putString(KEY_TOKEN, token)
+        .putLong(KEY_EXPIRES_AT, System.currentTimeMillis() + EXPIRE_TIME_MS)
+        .commit();
+
+    ClipData clip = ClipData.newPlainText(null, content);
+    PersistableBundle extras = new PersistableBundle();
+    extras.putBoolean(EXTRA_IS_SENSITIVE, true);
+    extras.putString(EXTRA_EXPIRY_TOKEN, token);
+    clip.getDescription().setExtras(extras);
+    getClipboard(app).setPrimaryClip(clip);
+
+    handler.removeCallbacks(inProcessExpiry);
+    handler.postDelayed(inProcessExpiry, EXPIRE_TIME_MS);
+    try {
+      scheduleAlarm(app);
+    } catch (Exception e) {
+      e.printStackTrace();
+    }
+  }
+
+  @Override
+  public void onReceive(Context context, Intent intent) {
+    Context app = context.getApplicationContext();
+    String action = intent.getAction();
+    if (Intent.ACTION_BOOT_COMPLETED.equals(action)
+        || Intent.ACTION_MY_PACKAGE_REPLACED.equals(action)) {
+      // Pending alarms were dropped; expire now if overdue, otherwise reschedule.
+      if (!expireIfOverdue(app) && prefs(app).contains(KEY_TOKEN)) {
+        scheduleAlarm(app);
+      }
+      return;
+    }
+    expire(app);
+  }
+
+  /** Expires a pending clip whose deadline passed while no alarm could fire. */
+  static synchronized boolean expireIfOverdue(Context context) {
+    Context app = context.getApplicationContext();
+    SharedPreferences prefs = prefs(app);
+    if (!prefs.contains(KEY_TOKEN)
+        || prefs.getLong(KEY_EXPIRES_AT, 0) > System.currentTimeMillis()) {
+      return false;
+    }
+    expire(app);
+    return true;
+  }
+
+  static synchronized void expire(Context app) {
+    handler.removeCallbacks(inProcessExpiry);
+    try {
+      AlarmManager alarmManager = (AlarmManager) app.getSystemService(Context.ALARM_SERVICE);
+      if (alarmManager != null) {
+        alarmManager.cancel(alarmIntent(app));
+      }
+    } catch (Exception e) {
+      e.printStackTrace();
+    }
+    SharedPreferences prefs = prefs(app);
+    String token = prefs.getString(KEY_TOKEN, null);
+    if (token == null) {
+      return;
+    }
+    prefs.edit().remove(KEY_TOKEN).remove(KEY_EXPIRES_AT).commit();
+    try {
+      ClipboardManager clipboard = getClipboard(app);
+      // Null when the clipboard is unreadable (background on Android 10+): clear regardless.
+      // Otherwise only clear while the clip is still the one written by setStringExpire.
+      ClipDescription description = clipboard.getPrimaryClipDescription();
+      if (description != null) {
+        PersistableBundle extras = description.getExtras();
+        String current = extras == null ? null : extras.getString(EXTRA_EXPIRY_TOKEN);
+        if (!token.equals(current)) {
+          return;
+        }
+      }
+      clearPrimaryClip(clipboard);
+    } catch (Exception e) {
+      e.printStackTrace();
+    }
+  }
+
+  static void clearPrimaryClip(ClipboardManager clipboard) {
+    if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.P) {
+      clipboard.clearPrimaryClip();
+    } else {
+      clipboard.setPrimaryClip(ClipData.newPlainText("", ""));
+    }
+  }
+
+  private static void scheduleAlarm(Context app) {
+    AlarmManager alarmManager = (AlarmManager) app.getSystemService(Context.ALARM_SERVICE);
+    if (alarmManager == null) {
+      return;
+    }
+    long remaining =
+        Math.max(0, prefs(app).getLong(KEY_EXPIRES_AT, 0) - System.currentTimeMillis());
+    long triggerAt = SystemClock.elapsedRealtime() + Math.min(remaining, EXPIRE_TIME_MS);
+    PendingIntent intent = alarmIntent(app);
+    if (Build.VERSION.SDK_INT < Build.VERSION_CODES.S || alarmManager.canScheduleExactAlarms()) {
+      alarmManager.setExactAndAllowWhileIdle(
+          AlarmManager.ELAPSED_REALTIME_WAKEUP, triggerAt, intent);
+    } else {
+      alarmManager.setAndAllowWhileIdle(AlarmManager.ELAPSED_REALTIME_WAKEUP, triggerAt, intent);
+    }
+  }
+
+  private static PendingIntent alarmIntent(Context app) {
+    Intent intent = new Intent(app, ClipboardExpiryReceiver.class);
+    return PendingIntent.getBroadcast(
+        app, 0, intent, PendingIntent.FLAG_UPDATE_CURRENT | PendingIntent.FLAG_IMMUTABLE);
+  }
+
+  private static SharedPreferences prefs(Context app) {
+    return app.getSharedPreferences(PREFS, Context.MODE_PRIVATE);
+  }
+
+  private static ClipboardManager getClipboard(Context app) {
+    return (ClipboardManager) app.getSystemService(Context.CLIPBOARD_SERVICE);
+  }
+}
